one-api-linux-amd64
*.tar.gz
*.tar.gz.sha256
web/build
web/modern/node_modules
web/modern/dist
web/default/node_modules
web/default/build

# 运行时数据与日志（属于部署机器，不属于镜像）
data
one-api.db
*.db
*.log
*.dump
scripts/smoke/one-api
scripts/smoke/tiktoken
scripts/smoke/*.db
scripts/smoke/*.log
scripts/smoke/*.out
