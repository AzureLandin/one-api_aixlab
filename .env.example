# Copy this file to `.env` next to docker-compose.yml and fill it in.
# `.env` is gitignored and must never be committed.
# Note: compose interpolation needs SESSION_SECRET even for `docker compose down`.

# REQUIRED. Signs session cookies.
# Reuse the existing production value (31 characters there); changing it
# invalidates every logged-in session at cutover.
SESSION_SECRET=

# Optional overrides (the values shown are the defaults).
TZ=Asia/Shanghai
SHUTDOWN_TIMEOUT_SECONDS=600
ONEAPI_HTTP_PORT=3000

# Stamped into the binary as common.Version and used as the image tag.
VERSION=docker

# Verbose request logging.
DEBUG=false
